{
  "expo": {
    "name": "introduction-to-mobile",
    "slug": "introduction-to-mobile",
    "scheme": "intro-mobile",
    "version": "1.0.0",
    "plugins": [
      ["expo-router", { "root": "./app" }],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir que o app use a câmera para tirar fotos no demo.",
          "photosPermission": "Permitir que o app acesse fotos, se necessário.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o app use a câmera para o preview ao vivo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
